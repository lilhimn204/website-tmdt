# Local Cloudflare bindings only. Copy to .dev.vars when needed.
APP_ENV="local"
APP_ORIGIN="http://127.0.0.1:8788"

# Auth adapter uses this URL; the health API still does not probe the database.
SUPABASE_URL="http://127.0.0.1:54321"

# Run npm.cmd run auth:setup:local to fill the local publishable/gateway values.
# The admin adapter never uses SUPABASE_SECRET_KEY. Only the commerce RPC uses it.
# Configure hosted secrets only when deploying the corresponding later modules.
# Do not paste secrets into chat, source code, screenshots or a VITE_ variable.
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
DATA_API_GATEWAY_SECRET=""
TURNSTILE_SECRET_KEY=""

# npm.cmd run commerce:setup:local fills these only for local tests.
# Production has NO default TTL; D07 requires an explicit business decision.
REQUEST_HASH_SECRET=""
GUEST_SESSION_TTL_SECONDS=""
