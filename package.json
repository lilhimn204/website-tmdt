{
  "name": "website-tmdt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 5173",
    "build": "react-router build",
    "pages:dev": "wrangler pages dev --ip 127.0.0.1 --port 8788",
    "preview": "npm run build && npm run pages:dev",
    "pages:check": "wrangler pages functions build --outdir .wrangler/build-check",
    "typecheck": "react-router typegen && tsc -p tsconfig.json && tsc -p tsconfig.functions.json && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:navigation": "node scripts/check-navigation.mjs",
    "test:home": "node scripts/check-home.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run pages:check",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
